# Copie para .env.local e ajuste (opcional: sem nenhum .env o dashboard já usa a API).
# api  = busca no Backend (padrão; `python main.py` em Backend/ precisa estar rodando)
# mock = lê src/data/mock/*.json (ou simplesmente `npm run dev:mock`, sem .env nenhum)
VITE_DATA_SOURCE=api
# Base das rotas. "/api" = mesma origem: o Vite repassa ao Backend (host/porta lidos de
# Backend/config/api.yaml) e, no build servido pelo próprio Backend, não há proxy nenhum.
VITE_API_BASE_URL=/api
