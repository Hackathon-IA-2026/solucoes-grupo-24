# dados brutos (nunca versionar)
Backend/data/raw/

# derivados grandes
*.parquet
*.feather
*.duckdb
*.duckdb.wal
Backend/data/processed/**/*.csv
# exceção: tabela pequena e de referência, versionada para o time todo usar
!Backend/data/processed/mapeamento_subsistema_area.csv

# estado e trava do Backend/run_heavywork.py (locais de cada máquina)
Backend/data/_estado_heavywork.json
Backend/data/_heavywork.lock

# modelos treinados e previsões do replay (etapas 3 e 4 do run_heavywork.py)
Backend/data/modelos/

# cópia do contrato publicado (regravada a cada run_heavywork.py)
Backend/output/contrato.json

# saídas MOCK da auditoria da MMGD (regeneradas por `python -m pipeline.auditoria_camadas_2_3 --mock`)
Backend/output/auditoria/mock/

# banco SQLite do Backend (recriado pelo carregador)
Backend/**/*.db
Backend/**/*.sqlite
Backend/**/*.sqlite3

# temporários do DuckDB (limites em Backend/config/fontes_ons.yaml)
_duckdb_tmp/

# checkpoints e artefatos de modelo
*.ckpt
*.pt
*.pth
*.onnx
*.joblib
*.pkl
lightning_logs/
mlruns/

# segredos
.env
.env.*
!.env.example
.cdsapirc

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# editores / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# protótipo O.R.A.C.U.L.O. (Backend/oraculo): cache de trabalho das fontes (ONS, ANEEL, IBGE,
# Open-Meteo), regravado sob demanda, e o cache isolado da suíte de testes
Backend/data/oraculo_cache/
Backend/.cache-tests/

# Conciliação de MMGD (src/spatial/conciliacao.py, pipeline/paineis_por_transformador.py): saídas
# regeneráveis a partir do checkpoint e dos dados. Vão para a AWS no pacote de dados do deploy_ecs.py.
Backend/output/conciliacao/
Backend/output/visao/*.geojson
